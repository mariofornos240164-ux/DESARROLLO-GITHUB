# Copia este archivo con el nombre .env y pon tus valores.
# El archivo .env NO se sube a GitHub.

# Base de datos
DB_SERVER=localhost
DB_NAME=DB_SCRUM_PLANNING
DB_USER=WebSocket
DB_PASSWORD=pon_aqui_la_contraseña

# JWT (mínimo 32 caracteres). Puedes generar una con:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=30
JWT_ADMIN_ROLE_ID=1
