# Copia este archivo como .env. El archivo .env está ignorado por Git.

# Base de datos
DB_SERVER=localhost
DB_NAME=DB_SCRUM_PLANNING
# Usa la cuenta de Windows que inicia uvicorn (requiere permisos en SQL Server).
DB_TRUSTED_CONNECTION=true

# Alternativa: autenticación SQL. Si se usa, cambia DB_TRUSTED_CONNECTION a false.
DB_USER=
DB_PASSWORD=

# JWT (mínimo 32 caracteres; genera un valor local y no lo compartas):
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=30

# ID del rol administrador en SQM_SECURITY.TBL_Roles (el rol "Admin", NO el
# rol "Usuario de prueba" de la cuenta demo). Consulta el ID con:
#   SELECT rolId, rolName, rolEnable FROM SQM_SECURITY.TBL_Roles;
# Solo afecta /create, /update, /list y /roles; no impide entrar a la home.
JWT_ADMIN_ROLE_ID=1
